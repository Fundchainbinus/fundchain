# ===== Server =====
PORT=3000
WEB_URL=http://localhost:5173
NODE_ENV=development

# ===== Database: Supabase (PostgreSQL) =====
# Ambil dari Supabase Dashboard → Connect → ORMs → Prisma.
# DATABASE_URL: Transaction pooler (port 6543) — dipakai aplikasi.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL: Session pooler (port 5432) — dipakai prisma migrate.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ===== Mode demo tanpa login =====
# Identitas diambil dari header X-Acting-User (dipilih lewat persona switcher di UI).
# JANGAN aktifkan di produksi — ganti dengan Microsoft SSO.
DEMO_MODE=true

# ===== Dev tools (tombol "Simulasi Bayar") =====
ENABLE_DEV_TOOLS=true

# ===== Payment =====
# mock | pakasir
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com

# ===== Storage =====
UPLOAD_DIR=./uploads

# ===== Blockchain =====
# Local: hardhat node (pnpm chain). CONTRACT_ADDRESS kosong → dibaca dari contracts/deployments/<network>.json
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
# Kunci akun #1 Hardhat (PUBLIK, khusus local). Untuk Sepolia isi dengan relayer wallet sendiri.
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BLOCKCHAIN_CONFIRMATIONS=1
WORKER_ENABLED=true
WORKER_POLL_MS=2000
