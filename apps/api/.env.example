# ===== Server =====
PORT=3000
WEB_URL=http://localhost:5173
NODE_ENV=development

# ===== Database: Supabase (PostgreSQL) =====
# Ambil dari Supabase Dashboard → Connect → ORMs → Prisma.
# DATABASE_URL: Transaction pooler (port 6543) — dipakai aplikasi.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL: Session pooler (port 5432) — dipakai prisma migrate.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ===== Login Google =====
# OAuth Client ID (tipe Web application) dari Google Cloud Console.
# Tambahkan http://localhost:5173 (dan domain produksi) ke "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Email admin (pisahkan koma) — otomatis berperan ADMIN saat login. Selain itu: STUDENT.
ADMIN_EMAILS=
# Secret penandatangan token sesi (kosong → diturunkan dari DATABASE_URL).
SESSION_SECRET=
# Secret penandatangan link file sementara (kosong → diturunkan dari DATABASE_URL).
FILE_URL_SECRET=

# ===== Dev tools (tombol "Simulasi Bayar") =====
ENABLE_DEV_TOOLS=true

# ===== Mode demo (BFD-12) =====
# true -> GET /api/v1/auth/demo?persona=student|admin login sebagai user hasil seed
# (budi.santoso@binus.ac.id / admin@binus.ac.id). Default mati. Setiap login demo dicatat
# di audit log (AUTH_DEMO_LOGIN). PERHATIAN: bila DATABASE_URL menunjuk DB production,
# persona admin = admin seed yang asli.
DEMO_MODE=false
# Di production (NODE_ENV=production atau Vercel) DEMO_MODE diabaikan kecuali ini juga true.
DEMO_MODE_ALLOW_PRODUCTION=false

# ===== Payment =====
# mock | sakurupiah | pakasir (pakasir tidak dikembangkan lagi, D-002)
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
# Sakurupiah: API ID & API key dari dashboard merchant (sandbox diawali SANBOX-).
SAKURUPIAH_API_ID=
SAKURUPIAH_API_KEY=
# true = https://sakurupiah.id/api-sanbox, false = https://sakurupiah.id/api (production)
SAKURUPIAH_SANDBOX=true
# URL publik webhook yang bisa dijangkau Sakurupiah, mis. https://fundchain-api.vercel.app/api/v1/webhooks/payment
SAKURUPIAH_CALLBACK_URL=
# Field phone wajib di Sakurupiah. Isi nomor merchant/penanggung jawab (08xx / 62xx), bukan nomor donatur.
SAKURUPIAH_PHONE=
# QRIS (default) | QRISMU | QRIS2 | QRISC | kode VA lain
SAKURUPIAH_METHOD=QRIS
# merchant = fee ditanggung FundChain | customer = donatur membayar fee di atas nominal donasi
SAKURUPIAH_FEE_BY=merchant
PAKASIR_PROJECT=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com

# ===== Blockchain =====
# Local: hardhat node (pnpm chain). CONTRACT_ADDRESS kosong → dibaca dari contracts/deployments/<network>.json
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
# Kunci akun #1 Hardhat (PUBLIK, khusus local). Untuk Sepolia isi dengan relayer wallet sendiri.
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# BFD-48: konfirmasi blok sebelum CONFIRMED (minimal 1). Default 2 (Sepolia/production).
# Kosong + CHAIN_ID=31337 (Hardhat automine) -> 1, karena blok kedua baru muncul saat ada tx lain.
# Untuk Sepolia set eksplisit: BLOCKCHAIN_CONFIRMATIONS=2
BLOCKCHAIN_CONFIRMATIONS=
# Saldo relayer di bawah ini (ETH) -> warning di log worker & tanda "rendah" di Admin
RELAYER_MIN_BALANCE_ETH=0.02
# Batas tunggu receipt per tx (ms); lewat batas, konfirmasi dilanjutkan tick berikutnya
BLOCKCHAIN_CONFIRM_WAIT_MS=45000
WORKER_ENABLED=true
WORKER_POLL_MS=2000

# ===== Integrity checker =====
# Hash checker otomatis: donasi dicek ulang bila pengecekan terakhir lebih lama dari ini (default 1 jam)
INTEGRITY_CHECK_INTERVAL_MS=3600000
# Maksimal donasi per putaran checker
INTEGRITY_CHECK_BATCH=50
# Campaign FROZEN yang tidak dipulihkan disembunyikan dari dashboard setelah N hari (soft-delete)
FROZEN_SOFT_DELETE_DAYS=30

# ===== Alert operasional =====
# Discord webhook untuk alert (kosong = alert hanya di log)
ALERT_WEBHOOK_URL=
# Notarisasi yang belum CONFIRMED lebih lama dari ini (ms) dianggap macet (default 10 menit)
STUCK_TX_ALERT_MS=600000

# ===== Serverless (Vercel) =====
# interval = polling terus (server biasa); on-demand = dipicu request & cron (Vercel)
WORKER_MODE=interval
# Secret endpoint /api/v1/cron/tick (Vercel Cron mengirim Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ===== Penyimpanan file (BFD-42 / BFD-15) =====
# db (default) = file di tabel stored_files (bytea), upload multipart lewat API maks 4MB.
# supabase = file di Supabase Storage (bucket PRIVAT), browser upload langsung maks 10MB.
# Bila supabase tapi SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY kosong -> error di log & jatuh ke db.
STORAGE_DRIVER=db
# Project URL, mis. https://<PROJECT_REF>.supabase.co
SUPABASE_URL=
# Service role / secret key: HANYA di server, jangan pernah di apps/web.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fundchain-files
